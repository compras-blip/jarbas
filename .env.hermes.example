# Copie para .env.hermes e preencha. NUNCA faça commit do .env.hermes.
# O login do ChatGPT NÃO vai aqui: ele é feito com `hermes auth add openai-codex`
# (ver docs/fase-0-instalacao.md) e fica salvo em runtime/hermes.

# Fuso horário do Atlas
HERMES_TIMEZONE=America/Manaus

# Bot do Telegram (criado no @BotFather)
TELEGRAM_BOT_TOKEN=
# Seu ID numérico do Telegram (pegue no @userinfobot). Vários IDs: separe por vírgula.
TELEGRAM_ALLOWED_USERS=

# Transcrição de áudio (teste 3) pela OpenAI. A Nous não oferece transcrição (rota 404, conferido 10/10).
# Chave da API da OpenAI (platform.openai.com), separada do plano do ChatGPT; cobrada por minuto de áudio.
# Com a chave preenchida, ligue stt.provider: openai no hermes/config.yaml.
VOICE_TOOLS_OPENAI_KEY=
STT_OPENAI_MODEL=gpt-4o-mini-transcribe
